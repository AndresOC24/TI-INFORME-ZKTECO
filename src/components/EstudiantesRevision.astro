  </label>
  <p id="students-review-results" class="panel__note" aria-live="polite"></p>
  <div class="table-wrap">
    <table class="table">
      <thead><tr><th>Estudiante</th><th>CI</th><th>Código académico</th><th>ID ZKTeco</th><th>Carrera</th><th>Motivo de revisión</th><th class="num">Días con entrada</th></tr></thead>
      <tbody id="students-review-body"></tbody>
    </table>
  </div>
</details>

