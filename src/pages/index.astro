---
import '@fontsource-variable/inter';
import '@fontsource-variable/inter-tight';
---

<!doctype html>
<html lang="es" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>Informe de acceso estudiantil · UNIFRANZ</title>
    <script is:inline>
      (() => {
        const t = localStorage.getItem('theme') ||
          (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.dataset.theme = t;
      })();
    </script>
  </head>
  <body>
    <!--
      DIRECTION CONTRACT · seed d93d2de6 · mode operate · code-led (no image gen)
      THESIS: A ZKTeco turnstile export becomes one calm, trustworthy institutional
        screen. It refuses the SaaS-dashboard rut (sidebar shell, indigo, identical
        sparkline cards): one dominant truth per band, orange used once.
      OWN-WORLD: near-neutral ground, single UNIFRANZ orange accent, black reserved
        for the brand tile; Inter Tight display + Inter UI, tabular numerals; hand-
        drawn SVG data-graphics at Linear/Observable finish. Light+dark by toggle.
      STORY: TI staff drops in the molinetes file, instantly reads how many students
        came, when, from which careers, and who was turned away for debt.
      FIRST VIEWPORT: brand header + period dateline; three file zones; then a hero
        band with the dominant figure (attendance % once BD is loaded, else unique
        entries) and a supporting stat row.
      FORM: institutional data report / analytics screen, canon executed straight
        (standing exit; quality bar Linear + Vercel/Observable). Seed d93d2de6.
      FINISH: unreviewed and undocumented is unfinished; this build ends with the
        finish review, the verdict, DESIGN.md, and every shipping raster carrying
        its provenance.
    -->

    <header class="topbar">
      <div class="brand">
        <img class="brand__logo" src="/images/logoUnifranz.png" alt="UNIFRANZ" width="44" height="44" />
        <div class="brand__text">
          <h1>Informe de acceso estudiantil</h1>
          <p id="period" class="period">Carga un archivo para comenzar</p>
        </div>
      </div>
      <button id="theme-toggle" class="icon-btn" type="button" aria-pressed="false" aria-label="Cambiar tema claro/oscuro" title="Cambiar tema">
        <svg class="i-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.2"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M19.1 4.9L17 7M7 17l-2.1 2.1"/></svg>
        <svg class="i-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a7 7 0 1 0 10.5 10.5Z"/></svg>
      </button>
    </header>

    <main class="wrap">
      <section class="uploads" aria-label="Cargar archivos">
        <label class="drop" data-kind="molinetes" data-state="idle">
          <input class="drop__input" type="file" accept=".xls,.xlsx,.csv" hidden />
          <svg class="drop__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 15V4M8 8l4-4 4 4"/><path d="M4 15v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-3"/></svg>
          <span class="drop__body">
            <span class="drop__title">Registro de molinetes</span>
            <span class="drop__status">Arrastra o haz clic · .xls / .xlsx</span>
            <span class="drop__file"></span>
          </span>
          <span class="drop__badge">Principal</span>
        </label>

        <label class="drop" data-kind="bd" data-state="idle">
          <input class="drop__input" type="file" accept=".xls,.xlsx,.csv" hidden />
          <svg class="drop__icon" viewBox="0 0 24 24" aria-hidden="true"><ellipse cx="12" cy="5.5" rx="7.5" ry="3"/><path d="M4.5 5.5v6c0 1.7 3.4 3 7.5 3s7.5-1.3 7.5-3v-6M4.5 11.5v6c0 1.7 3.4 3 7.5 3s7.5-1.3 7.5-3v-6"/></svg>
          <span class="drop__body">
            <span class="drop__title">BD de estudiantes</span>
            <span class="drop__status">Total de activos - cada 6 meses</span>
            <span class="drop__file"></span>
          </span>
        </label>

        <label class="drop" data-kind="nuevos" data-state="idle">
          <input class="drop__input" type="file" accept=".xls,.xlsx,.csv" hidden />
          <svg class="drop__icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3.2"/><path d="M3.5 20a5.5 5.5 0 0 1 11 0M18 7v6M21 10h-6"/></svg>
          <span class="drop__body">
            <span class="drop__title">Nuevos inscritos</span>
            <span class="drop__status">Admisiones por gestión</span>
            <span class="drop__file"></span>
          </span>
        </label>
      </section>

      <section id="empty" class="empty">
        <svg class="empty__mark" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 15V4M8 8l4-4 4 4"/><path d="M4 15v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-3"/></svg>
        <h2>Carga el registro de molinetes para generar el informe</h2>
        <p>Todo se procesa en tu navegador. El período se calcula automáticamente a partir de las fechas del archivo generado por el Zkteco. Añade la BD de estudiantes para ver la tasa de asistencia y el CI, y el archivo de nuevos inscritos para el bloque de admisiones.</p>
      </section>

      <div id="report" hidden>
        <section class="rangebar" aria-label="Rango de fechas">
          <div class="rangebar__fields">
            <label class="field"><span>Desde</span><input id="range-from" type="date" /></label>
            <label class="field"><span>Hasta</span><input id="range-to" type="date" /></label>
          </div>
          <div class="rangebar__actions">
            <button id="range-7" class="btn btn--ghost btn--sm" type="button">Últimos 7 días</button>
            <button id="range-all" class="btn btn--ghost btn--sm" type="button">Todo el período</button>
          </div>
          <p id="range-info" class="rangebar__info"></p>
        </section>

        <p id="range-empty" class="range-empty" hidden>No hay registros de estudiantes en el rango seleccionado. Amplía las fechas o vuelve a «Todo el período».</p>

        <div id="report-body">
        <section id="summary" class="summary" aria-label="Resumen"></section>

        <div class="grid-2">
          <section class="panel">
            <div class="panel__head">
              <h2>Afluencia por hora</h2>
              <div class="panel__tools">
                <div class="legend"><span class="legend__k legend__k--ent">Entradas</span><span class="legend__k legend__k--sal">Salidas</span></div>
                <button class="expand" type="button" data-chart="hourly" title="Ampliar" aria-label="Ampliar afluencia por hora">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"/></svg>
                </button>
              </div>
            </div>
            <p id="hourly-note" class="panel__note"></p>
            <div id="chart-hourly" class="chart-box"></div>
            <p id="hourly-peak" class="peak-note"></p>
          </section>

          <section class="panel">
            <div class="panel__head">
              <h2>Ingresos por día</h2>
              <button class="expand" type="button" data-chart="daily" title="Ampliar" aria-label="Ampliar ingresos por día">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"/></svg>
              </button>
            </div>
            <p class="panel__note">Estudiantes que ingresaron cada día</p>
            <div id="chart-daily" class="chart-box"></div>
          </section>
        </div>

        <section class="panel">
          <div class="panel__head">
            <h2>Ingresos por carrera</h2>
            <button class="expand" type="button" data-chart="careers" title="Ampliar" aria-label="Ampliar ingresos por carrera">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"/></svg>
            </button>
          </div>
          <p class="panel__note">Ingresos únicos por carrera. El número en rojo son estudiantes bloqueados por deuda. <span id="careers-coverage"></span></p>
          <div id="careers" class="bars"></div>
        </section>

        <section class="panel panel--alert" aria-label="Bloqueados por deuda">
          <div class="panel__head">
            <h2>Bloqueados <span id="blocked-count" class="tally">0</span></h2>
            <button class="expand" type="button" data-chart="blocked" title="Ampliar" aria-label="Ampliar bloqueados por carrera">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"/></svg>
            </button>
          </div>
          <p class="panel__note">Estudiantes con acceso denegado (evento «Deshabilitada»). <span id="blocked-coverage"></span></p>
          <div id="blocked-by-career" class="bars"></div>

          <div class="blocked__actions">
            <button id="blocked-toggle" class="btn" type="button" aria-expanded="false" aria-controls="blocked-list">
              Ver listado <span class="count">(0)</span>
              <svg class="chev" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </button>
            <button id="blocked-export" class="btn btn--ghost" type="button">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12M8 11l4 4 4-4"/><path d="M4 21h16"/></svg>
              Exportar CSV
            </button>
          </div>

          <div id="blocked-list" class="table-wrap" hidden>
            <table class="table">
              <thead><tr><th>Carrera</th><th>Apellidos</th><th>Nombres</th><th class="num">CI</th></tr></thead>
              <tbody id="blocked-tbody"></tbody>
            </table>
          </div>
        </section>

        <section id="admissions" class="panel" hidden aria-label="Admisiones">
          <div class="panel__head">
            <h2>Nuevos inscritos <span id="adm-total" class="tally tally--accent">0</span></h2>
            <button class="expand" type="button" data-chart="admissions" title="Ampliar" aria-label="Ampliar nuevos inscritos">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"/></svg>
            </button>
          </div>
          <div class="grid-2">
            <div>
              <p class="panel__note">Por carrera</p>
              <div id="adm-careers" class="bars"></div>
            </div>
            <div>
              <p class="panel__note">Por mes de inscripción</p>
              <div id="adm-months" class="months"></div>
            </div>
          </div>
        </section>
        </div>
      </div>
    </main>

    <div id="modal" class="modal" hidden>
      <div class="modal__scrim" data-close></div>
      <div class="modal__box" role="dialog" aria-modal="true" aria-labelledby="modal-title">
        <header class="modal__head">
          <div class="modal__titles">
            <h2 id="modal-title"></h2>
            <p id="modal-sub" class="modal__sub"></p>
          </div>
          <div class="modal__tools">
            <div id="modal-controls" class="segmented"></div>
            <button id="modal-close" class="icon-btn" type="button" data-close aria-label="Cerrar" title="Cerrar (Esc)">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
            </button>
          </div>
        </header>
        <div id="modal-body" class="modal__body"></div>
      </div>
    </div>

    <style is:global>
      :root {
        --bg: #f4f4f3; --surface: #ffffff; --surface-2: #fafafa;
        --ink: #18181b; --ink-2: #3f3f46; --muted: #71717a;
        --border: #e5e5e6; --track: #ededee;
        --accent: #ef5a22; --accent-soft: #fdece4; --accent-ink: #ffffff;
        --series-2: #a8a8ae; --alert: #d92d20; --alert-soft: #fce9e7;
        --shadow: 0 1px 2px rgba(24,24,27,.05), 0 10px 28px -14px rgba(24,24,27,.18);
        --radius: 14px; --radius-sm: 9px;
        --sans: 'Inter Variable', system-ui, sans-serif;
        --display: 'Inter Tight Variable', 'Inter Variable', system-ui, sans-serif;
        --maxw: 1180px;
        color-scheme: light;   /* calendario nativo de <input type="date"> */
      }
      html[data-theme='dark'] {
        --bg: #0c0c0e; --surface: #151518; --surface-2: #1b1b1f;
        --ink: #f4f4f5; --ink-2: #d4d4d8; --muted: #9a9aa2;
        --border: #29292f; --track: #232329;
        --accent: #ff6a37; --accent-soft: #2a1207; --accent-ink: #180a04;
        --series-2: #55555e; --alert: #f97066; --alert-soft: #2a1210;
        --shadow: 0 1px 2px rgba(0,0,0,.4), 0 16px 40px -18px rgba(0,0,0,.7);
        color-scheme: dark;
      }

      * { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; }
      body {
        margin: 0; background: var(--bg); color: var(--ink);
        font-family: var(--sans);
        font-feature-settings: 'cv05' 1, 'ss01' 1;
        line-height: 1.5; letter-spacing: -0.011em;
        -webkit-font-smoothing: antialiased;
      }
      h1, h2, h3 { font-family: var(--display); font-weight: 600; letter-spacing: -0.02em; margin: 0; }
      ::selection { background: var(--accent); color: var(--accent-ink); }
      :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 4px; }
      * { caret-color: var(--accent); }
      .num, dd, .tally, .chart, .cbar__val, .table .num { font-variant-numeric: tabular-nums; }
      ::-webkit-scrollbar { width: 11px; height: 11px; }
      ::-webkit-scrollbar-thumb { background: var(--track); border: 3px solid var(--surface); border-radius: 999px; }
      ::-webkit-scrollbar-thumb:hover { background: var(--muted); }

      /* ---------- header ---------- */
      .topbar {
        position: sticky; top: 0; z-index: 20;
        display: flex; align-items: center; justify-content: space-between; gap: 16px;
        padding: 14px clamp(16px, 4vw, 40px);
        background: color-mix(in srgb, var(--surface) 82%, transparent);
        backdrop-filter: saturate(1.4) blur(12px);
        border-bottom: 1px solid var(--border);
      }
      .brand { display: flex; align-items: center; gap: 14px; min-width: 0; }
      .brand__logo { border-radius: 10px; flex: none; display: block; background: #000; }
      .brand__text { min-width: 0; }
      .brand h1 { font-size: clamp(1.06rem, 1.4vw, 1.28rem); line-height: 1.15; }
      .period { margin: 2px 0 0; font-size: .86rem; color: var(--muted); font-family: var(--sans); }
      .period strong { color: var(--ink-2); font-weight: 600; }

      .icon-btn {
        flex: none; width: 40px; height: 40px; display: grid; place-items: center;
        border: 1px solid var(--border); border-radius: 10px; background: var(--surface);
        color: var(--ink-2); cursor: pointer; transition: background .18s, border-color .18s, color .18s;
      }
      .icon-btn:hover { color: var(--ink); border-color: var(--muted); }
      .icon-btn svg { width: 19px; height: 19px; fill: none; stroke: currentColor; stroke-width: 1.9; stroke-linecap: round; stroke-linejoin: round; }
      .icon-btn .i-moon { display: none; }
      html[data-theme='dark'] .icon-btn .i-sun { display: none; }
      html[data-theme='dark'] .icon-btn .i-moon { display: block; }

      /* ---------- layout ---------- */
      .wrap { max-width: var(--maxw); margin: 0 auto; padding: clamp(20px, 3.4vw, 34px) clamp(16px, 4vw, 40px) 40px; }
      .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }

      /* ---------- uploads ---------- */
      .uploads { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 26px; }
      .drop {
        position: relative; display: flex; align-items: center; gap: 13px; cursor: pointer;
        padding: 14px 16px; background: var(--surface); border: 1px solid var(--border);
        border-radius: var(--radius); box-shadow: var(--shadow);
        transition: border-color .18s, transform .18s, box-shadow .18s;
      }
      .drop:hover { border-color: color-mix(in srgb, var(--accent) 45%, var(--border)); }
      .drop.is-over { border-color: var(--accent); transform: translateY(-1px); box-shadow: 0 0 0 3px var(--accent-soft), var(--shadow); }
      .drop__icon { width: 26px; height: 26px; flex: none; fill: none; stroke: var(--muted); stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; transition: stroke .18s; }
      .drop:hover .drop__icon, .drop[data-state='done'] .drop__icon { stroke: var(--accent); }
      .drop__body { display: flex; flex-direction: column; min-width: 0; gap: 1px; }
      .drop__title { font-weight: 600; font-size: .95rem; }
      .drop__status { font-size: .78rem; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .drop__file { font-size: .72rem; color: var(--muted); opacity: .8; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .drop__file:empty { display: none; }
      .drop__badge {
        position: absolute; top: 10px; right: 10px; font-size: .72rem; font-weight: 700; letter-spacing: .04em;
        text-transform: uppercase; color: var(--accent); background: var(--accent-soft); padding: 3px 7px; border-radius: 999px;
      }
      .drop[data-state='done'] { border-color: color-mix(in srgb, var(--accent) 55%, var(--border)); }
      .drop[data-state='done'] .drop__status { color: var(--accent); font-weight: 600; }
      .drop[data-state='error'] .drop__status { color: var(--alert); font-weight: 600; }
      .drop[data-state='busy'] .drop__status { color: var(--ink-2); }
      .drop[data-state='busy'] .drop__icon { animation: pulse 1s ease-in-out infinite; }
      @keyframes pulse { 50% { opacity: .35; } }

      /* ---------- empty ---------- */
      .empty { text-align: center; max-width: 560px; margin: 8vh auto; }
      .empty__mark { width: 46px; height: 46px; fill: none; stroke: var(--accent); stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; margin-bottom: 6px; }
      .empty h2 { font-size: clamp(1.2rem, 2.4vw, 1.7rem); line-height: 1.2; }
      .empty p { color: var(--muted); margin-top: 12px; font-size: .95rem; }

      /* ---------- rango de fechas ---------- */
      .rangebar {
        display: flex; align-items: flex-end; gap: 14px; flex-wrap: wrap;
        background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius);
        box-shadow: var(--shadow); padding: 14px 18px; margin-bottom: 18px;
      }
      .rangebar__fields { display: flex; gap: 10px; }
      .field { display: flex; flex-direction: column; gap: 5px; font-size: .74rem; color: var(--muted); }
      .field input {
        font-family: var(--sans); font-size: .88rem; color: var(--ink);
        background: var(--surface-2); border: 1px solid var(--border);
        border-radius: var(--radius-sm); padding: 7px 10px;
        font-variant-numeric: tabular-nums; transition: border-color .18s;
      }
      .field input:hover { border-color: var(--muted); }
      .rangebar__actions { display: flex; gap: 8px; }
      .btn--sm { padding: 7px 12px; font-size: .8rem; }
      .btn:disabled { opacity: .45; cursor: default; filter: none; }
      .rangebar__info { margin: 0 0 3px auto; font-size: .78rem; color: var(--muted); text-align: right; }
      .rangebar__info b { color: var(--accent); font-weight: 600; font-variant-numeric: tabular-nums; }
      .period__flag { color: var(--accent); font-weight: 600; }
      .range-empty {
        text-align: center; color: var(--muted); font-size: .92rem;
        border: 1px dashed var(--border); border-radius: var(--radius);
        padding: 34px 20px; margin: 0;
      }

      /* ---------- summary ---------- */
      .summary {
        display: grid; grid-template-columns: minmax(240px, 0.9fr) 2fr; gap: 22px; align-items: stretch;
        background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius);
        box-shadow: var(--shadow); padding: 24px; margin-bottom: 18px;
      }
      .hero { display: flex; flex-direction: column; justify-content: center; padding-right: 22px; border-right: 1px solid var(--border); }
      .hero__num { font-family: var(--display); font-weight: 650; font-size: clamp(2.6rem, 5.4vw, 4rem); line-height: .95; letter-spacing: -0.04em; color: var(--accent); }
      .hero__meta { display: flex; flex-direction: column; margin-top: 12px; }
      .hero__label { font-weight: 600; font-size: .95rem; }
      .hero__sub { color: var(--muted); font-size: .86rem; margin-top: 3px; }
      .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(118px, 1fr)); gap: 20px 22px; margin: 0; align-content: center; }
      .stat dt { font-size: .8rem; color: var(--muted); }
      .stat dd { margin: 4px 0 0; font-family: var(--display); font-weight: 600; font-size: clamp(1.5rem, 2.6vw, 2rem); letter-spacing: -0.03em; line-height: 1; }
      .stat--alert dd { color: var(--alert); }
      .stat__note { margin: 4px 0 0; font-size: .72rem; color: var(--muted); }

      /* ---------- panels ---------- */
      .panel { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); box-shadow: var(--shadow); padding: 20px 22px; margin-bottom: 18px; }
      .grid-2 > .panel { margin-bottom: 0; }
      .panel__head { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
      .panel h2 { font-size: 1.06rem; display: flex; align-items: center; gap: 10px; }
      .panel__note { margin: 4px 0 16px; font-size: .8rem; color: var(--muted); }
      .panel--alert { border-color: color-mix(in srgb, var(--alert) 24%, var(--border)); }
      .tally { font-family: var(--display); font-weight: 700; font-size: 1.06rem; color: var(--alert); background: var(--alert-soft); padding: 2px 10px; border-radius: 999px; letter-spacing: -0.01em; }
      .tally--accent { color: var(--accent); background: var(--accent-soft); }
      .legend { display: flex; gap: 16px; font-size: .78rem; color: var(--muted); }
      .legend__k { display: inline-flex; align-items: center; gap: 6px; }
      .legend__k::before { content: ''; width: 10px; height: 10px; border-radius: 3px; }
      .legend__k--ent::before { background: var(--accent); }
      .legend__k--sal::before { background: var(--series-2); }

      /* ---------- ampliar / modal ---------- */
      .panel__tools { display: flex; align-items: center; gap: 14px; }
      .expand {
        flex: none; width: 30px; height: 30px; display: grid; place-items: center; cursor: pointer;
        border: 1px solid var(--border); border-radius: 10px; background: var(--surface); color: var(--muted);
        transition: color .18s, border-color .18s, background .18s;
      }
      .expand:hover { color: var(--accent); border-color: color-mix(in srgb, var(--accent) 45%, var(--border)); background: var(--accent-soft); }
      .expand svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

      .modal { position: fixed; inset: 0; z-index: 60; display: grid; place-items: center; padding: clamp(10px, 3vw, 34px); }
      .modal[hidden] { display: none; }
      .modal__scrim { position: absolute; inset: 0; background: color-mix(in srgb, #000 55%, transparent); backdrop-filter: blur(3px); animation: fade .18s ease both; }
      .modal__box {
        position: relative; display: flex; flex-direction: column; width: min(1180px, 100%); max-height: 92vh;
        background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius);
        box-shadow: 0 24px 70px -20px rgba(0,0,0,.5); animation: pop .2s cubic-bezier(.2,.8,.2,1) both;
      }
      .modal__head {
        display: flex; align-items: flex-start; justify-content: space-between; gap: 16px;
        padding: 18px 20px; border-bottom: 1px solid var(--border);
      }
      .modal__titles { min-width: 0; }
      .modal__head h2 { font-size: 1.2rem; }
      .modal__sub { margin: 3px 0 0; font-size: .82rem; color: var(--muted); }
      .modal__tools { display: flex; align-items: center; gap: 10px; flex: none; }
      .modal__body { padding: 20px; overflow: auto; }
      @keyframes fade { from { opacity: 0; } }
      @keyframes pop { from { opacity: 0; transform: translateY(8px) scale(.99); } }

      .segmented { display: flex; gap: 2px; padding: 2px; background: var(--surface-2); border: 1px solid var(--border); border-radius: 10px; }
      .segmented:empty { display: none; }
      .segmented button {
        cursor: pointer; font-family: var(--sans); font-size: .8rem; font-weight: 600; color: var(--muted);
        background: transparent; border: 0; border-radius: var(--radius-sm); padding: 6px 12px; transition: color .16s, background .16s;
      }
      .segmented button:hover { color: var(--ink); }
      .segmented button[aria-pressed='true'] { background: var(--accent); color: var(--accent-ink); }

      .modal__scroll { overflow-x: auto; padding-bottom: 6px; }
      .modal__section { margin-top: 26px; }
      .modal__section:first-child { margin-top: 0; }
      .modal__section h3 { font-size: .92rem; margin-bottom: 4px; }
      .modal__section .panel__note { margin-top: 2px; }

      /* mapa de calor día × hora */
      .heatmap .hm-cell { fill: var(--accent); transition: stroke .12s; stroke: transparent; stroke-width: 2; }
      .heatmap .hm-cell.is-zero { fill: var(--track); fill-opacity: 1; }
      .heatmap .hm-cell:hover { stroke: var(--ink); }
      .heatmap .hm-day { font-variant-numeric: tabular-nums; }
      .hm-legend { display: inline-flex; align-items: center; gap: 5px; font-size: .74rem; color: var(--muted); }
      .hm-key { width: 15px; height: 15px; border-radius: 3px; background: var(--accent); opacity: var(--o); border: 1px solid var(--border); }

      /* ---------- charts ---------- */
      .chart-box { width: 100%; }
      .chart { width: 100%; height: auto; display: block; overflow: visible; }
      .chart .grid { stroke: var(--border); stroke-width: 1; shape-rendering: crispEdges; }
      .chart .axis { fill: var(--muted); font-family: var(--sans); font-size: .72rem; font-variant-numeric: tabular-nums; }
      .chart .col-ent { fill: var(--accent); }
      .chart .col-sal { fill: var(--series-2); }
      .chart .hit { fill: transparent; }
      .chart .hbar:hover .hit, .chart .dot:hover .hit { fill: color-mix(in srgb, var(--ink) 6%, transparent); }
      .chart .hbar { transition: opacity .15s; }
      .chart .hbar:hover .col-ent, .chart .hbar:hover .col-sal { opacity: .78; }
      .chart .hbar.peak .col-ent { fill: var(--accent); }
      .chart .peak-tag { fill: var(--accent); font-family: var(--sans); font-size: .72rem; font-weight: 700; }
      .chart .area { fill: var(--accent); opacity: .12; }
      .chart .trend { fill: none; stroke: var(--accent); stroke-width: 2.5; stroke-linejoin: round; stroke-linecap: round; }
      .chart .dot circle { fill: var(--surface); stroke: var(--accent); stroke-width: 2; transition: r .15s; }
      .chart .dot:hover circle { r: 5; }

      .peak-note {
        margin: 12px 0 0; padding-top: 12px; border-top: 1px solid var(--border);
        font-size: .8rem; color: var(--muted);
      }
      .peak-note:empty { display: none; }
      .peak-note b { color: var(--ink-2); font-weight: 600; }
      .peak__h { color: var(--accent); font-weight: 700; font-variant-numeric: tabular-nums; }

      /* ---------- tooltip ---------- */
      .tip {
        position: fixed; top: 0; left: 0; z-index: 80; pointer-events: none;
        min-width: 156px; padding: 9px 11px;
        background: var(--surface); border: 1px solid var(--border);
        border-radius: var(--radius-sm); box-shadow: var(--shadow);
        font-size: .8rem; line-height: 1.35;
      }
      .tip[hidden] { display: none; }
      .tip__t { font-weight: 600; font-size: .78rem; margin-bottom: 6px; font-variant-numeric: tabular-nums; }
      .tip__row { display: flex; align-items: center; gap: 8px; }
      .tip__dot { width: 9px; height: 9px; border-radius: 3px; flex: none; }
      .tip__dot--ent { background: var(--accent); }
      .tip__dot--sal { background: var(--series-2); }
      .tip__k { color: var(--muted); }
      .tip__v { margin-left: auto; font-variant-numeric: tabular-nums; }
      .tip__f { margin-top: 6px; padding-top: 6px; border-top: 1px solid var(--border); font-size: .72rem; color: var(--muted); }

      /* ---------- horizontal bars ---------- */
      .bars { display: flex; flex-direction: column; gap: 9px; }
      .cbar { display: grid; grid-template-columns: minmax(64px, 190px) 1fr auto; align-items: center; gap: 14px; }
      .cbar__id { display: flex; align-items: baseline; gap: 8px; min-width: 0; }
      .cbar__code { font-weight: 700; font-size: .8rem; letter-spacing: .01em; }
      .cbar__name { font-size: .78rem; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .cbar__track { height: 12px; background: var(--track); border-radius: 999px; overflow: hidden; }
      .cbar__fill { display: block; height: 100%; width: var(--w); background: var(--accent); border-radius: 999px; transform-origin: left; animation: grow .7s cubic-bezier(.2,.8,.2,1) both; }
      .cbar--alert .cbar__fill { background: var(--alert); }
      .cbar__val { font-weight: 600; font-size: .86rem; min-width: 44px; text-align: right; display: inline-flex; align-items: center; gap: 8px; justify-content: flex-end; }
      .cbar__deny { font-size: .72rem; font-weight: 700; color: var(--alert); background: var(--alert-soft); padding: 1px 7px; border-radius: 999px; }
      @keyframes grow { from { transform: scaleX(0); } }
      .cbar:nth-child(2) .cbar__fill { animation-delay: .03s; }
      .cbar:nth-child(3) .cbar__fill { animation-delay: .06s; }
      .cbar:nth-child(4) .cbar__fill { animation-delay: .09s; }
      .cbar:nth-child(5) .cbar__fill { animation-delay: .12s; }
      .cbar:nth-child(n+6) .cbar__fill { animation-delay: .15s; }

      /* ---------- month columns ---------- */
      .months { display: flex; align-items: flex-end; gap: 10px; height: 150px; padding-top: 10px; }
      .mbar { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 8px; height: 100%; justify-content: flex-end; }
      .mbar__col { position: relative; width: 100%; max-width: 46px; min-height: 3px; height: var(--h); background: var(--accent); border-radius: 6px 6px 0 0; transform-origin: bottom; animation: rise .6s cubic-bezier(.2,.8,.2,1) both; }
      .mbar__col b { position: absolute; top: -20px; left: 0; right: 0; text-align: center; font-size: .78rem; font-weight: 700; color: var(--ink-2); }
      .mbar__lab { font-size: .72rem; color: var(--muted); text-transform: capitalize; }
      @keyframes rise { from { transform: scaleY(0); } }

      /* ---------- blocked actions + table ---------- */
      .blocked__actions { display: flex; gap: 10px; margin-top: 18px; flex-wrap: wrap; }
      .btn {
        display: inline-flex; align-items: center; gap: 8px; cursor: pointer;
        font-family: var(--sans); font-weight: 600; font-size: .86rem;
        padding: 9px 15px; border-radius: 10px; border: 1px solid transparent;
        background: var(--accent); color: var(--accent-ink); transition: filter .16s, background .16s, border-color .16s;
      }
      .btn:hover { filter: brightness(1.06); }
      .btn svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
      .btn .chev { transition: transform .2s; }
      .btn[aria-expanded='true'] .chev { transform: rotate(180deg); }
      .btn--ghost { background: transparent; color: var(--ink-2); border-color: var(--border); }
      .btn--ghost:hover { border-color: var(--muted); color: var(--ink); filter: none; }

      .table-wrap { margin-top: 16px; max-height: 420px; overflow: auto; border: 1px solid var(--border); border-radius: var(--radius-sm); }
      .table { width: 100%; border-collapse: collapse; font-size: .86rem; }
      .table thead th { position: sticky; top: 0; background: var(--surface-2); text-align: left; font-weight: 600; color: var(--ink-2); padding: 10px 14px; border-bottom: 1px solid var(--border); z-index: 1; }
      .table th.num, .table td.num { text-align: right; font-variant-numeric: tabular-nums; }
      .table tbody td { padding: 9px 14px; border-bottom: 1px solid var(--border); color: var(--ink-2); }
      .table tbody tr:last-child td { border-bottom: none; }
      .table tbody tr:nth-child(even) { background: color-mix(in srgb, var(--surface-2) 55%, transparent); }
      .table tbody tr:hover { background: var(--accent-soft); }

      .foot { max-width: var(--maxw); margin: 0 auto; padding: 8px clamp(16px, 4vw, 40px) 40px; color: var(--muted); font-size: .78rem; }

      /* ---------- responsive ---------- */
      @media (max-width: 860px) {
        .uploads { grid-template-columns: 1fr; }
        .grid-2 { grid-template-columns: 1fr; }
        .summary { grid-template-columns: 1fr; }
        .hero { border-right: none; border-bottom: 1px solid var(--border); padding-right: 0; padding-bottom: 20px; }
      }
      @media (max-width: 520px) {
        .cbar { grid-template-columns: 58px 1fr auto; gap: 10px; }
        .cbar__name { display: none; }
        .stats { grid-template-columns: 1fr 1fr; }
        .rangebar__fields { flex: 1 1 100%; }
        .field { flex: 1; }
        .rangebar__info { margin: 0; text-align: left; }
      }

      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after { animation-duration: .001ms !important; animation-iteration-count: 1 !important; transition-duration: .001ms !important; }
      }

      /* ---------- print ---------- */
      @media print {
        :root { --shadow: none; }
        .topbar { position: static; backdrop-filter: none; }
        .uploads, .icon-btn, .blocked__actions, .foot, .rangebar, .expand, .modal { display: none !important; }
        #blocked-list { display: block !important; max-height: none; }
        .panel, .summary, .drop { break-inside: avoid; }
        body { background: #fff; }
      }
    </style>

    <script>
      import '../scripts/app.js';
    </script>
  </body>
</html>
